{
  "system": {
    "L": 6,
    "J": 1.0,
    "h_crit": 3.04438,
    "periodic": true
  },
  "net": {
    "CNN": {
      "filter_size": 3,
      "num_channels": 6,
      "num_layers": 2
    },
    "ResNet": {
      "filter_size": 4,
      "num_channels": 10,
